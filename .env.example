# Copy to .env (never commit .env). Empty means unset.

# ---- database (our own Postgres) ----
DATABASE_URL=postgresql://agent:CHANGE-ME@postgres:5432/support_agent

# ---- the T2 Ticketing System ----
# Local copy:  http://localhost:5041/TicketAPI   (from Docker: http://host.docker.internal:5041/TicketAPI)
# Production:  https://ticketsystem.t2.sa/TicketAPI
T2_BASE_URL=
T2_USER=
T2_PASSWORD=

# Nothing is written to the ticket system while this is true.
DRY_RUN=true

# ---- AI ----
GROQ_API_KEY=

# ---- knowledge bases and indexes (Qdrant) ----
# Local: http://localhost:6333 (qdrant.exe). Production: the server's.
QDRANT_URL=
# Turns every document into text before indexing, Markdown included (RAGent2 0.2.0).
# Local: http://localhost:8092 (a Docling container). Empty: nothing can be uploaded.
DOCLING_URL=
# Off: faster knowledge base searches, maybe less precise (RAGent2 0.2.0).
KB_RERANK=true
# Each product's knowledge base is named after its code (RICH -> rich).
# KB_TENANTS only for one named differently, e.g. KB_TENANTS=OLE5=ole5-docs
KB_TENANTS=
HISTORY_PRODUCTS=RICH,OLE5

# ---- our console (our team only) ----
# Long and random. Signs sign-ins and encrypts passwords saved on the Settings page.
SESSION_SECRET=

# ---- our API (called by the ticket system's server) ----
# Long and random; give the same value to their team, privately.
API_KEY=
# A ticket's page in their system, for links in our emails.
TICKET_URL=https://ticketsystem.t2.sa/Tickets/Details/{id}

# ---- mail ----
# Local test: SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_STARTTLS=false
# with scripts/mailcatcher.py running.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
WEEKLY_REPORT_RECIPIENTS=
