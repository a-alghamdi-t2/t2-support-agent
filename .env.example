# Copy to .env (never commit .env). Empty means unset.

# ---- database (our own Postgres) ----
DATABASE_URL=postgresql://agent:CHANGE-ME@postgres:5432/support_agent

# ---- the T2 Ticketing System ----
# Local copy:  http://localhost:5041/TicketAPI   (from Docker: http://host.docker.internal:5041/TicketAPI)
# Production:  https://ticketsystem.t2.sa/TicketAPI
T2_BASE_URL=
T2_USER=
T2_PASSWORD=

# Nothing is written to the ticket system while this is true.
DRY_RUN=true

# ---- AI ----
GROQ_API_KEY=

# ---- knowledge bases and indexes (Qdrant) ----
QDRANT_URL=
DOCLING_URL=
KB_TENANTS=RICH=rich,OLE5=ole5
HISTORY_PRODUCTS=RICH,OLE5

# ---- console ----
SESSION_SECRET=
SUPER_ADMIN_EMAILS=
REGISTRATION_ALLOWLIST=@t2.sa
CONSOLE_URL=

# ---- mail ----
SMTP_HOST=
SMTP_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
WEEKLY_REPORT_RECIPIENTS=
